{
  "schemaVersion": 1,
  "id": "zeraix/gmail-send",
  "version": "1.1.0",
  "name": "Gmail",
  "description": "Send email from chat through your own Gmail account, with guidance on when not to.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zeraix/registry/tree/main/plugins/zeraix/gmail-send",
  "pricing": {
    "model": "free"
  },
  "providers": {
    "google_auth": {
      "kind": "oauth",
      "tier": "host",
      "oauth": {
        "known_provider": "google",
        "scopes": [
          "https://www.googleapis.com/auth/gmail.send"
        ],
        "client": {
          "type": "host"
        },
        "redirect": {
          "method": "loopback"
        },
        "mints": "gmail_oauth"
      },
      "permissions": {
        "network": [
          "accounts.google.com",
          "oauth2.googleapis.com"
        ],
        "credentials": []
      }
    },
    "gmail_api": {
      "kind": "http",
      "tier": "sandboxed",
      "url": "https://gmail.googleapis.com",
      "auth": "google_auth",
      "permissions": {
        "network": [
          "gmail.googleapis.com"
        ],
        "credentials": [
          "gmail_oauth"
        ]
      }
    }
  },
  "capabilities": [
    {
      "type": "tool",
      "id": "send_email",
      "module": "mail",
      "name": "Send email",
      "description": "Send an email from the signed-in Gmail account. Sent immediately; no draft is saved and there is no undo. Provide `body.raw`: the complete RFC 2822 message (To/Subject/body headers included), base64url-encoded.",
      "provider": "gmail_api",
      "input_schema": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "description": "The Gmail Message resource. Set `raw` to the whole RFC 2822 message, base64url-encoded with no padding — for example the encoding of \"To: a@b.com\\r\\nSubject: Hi\\r\\n\\r\\nHello\". Optionally set `threadId` to reply within a thread.",
            "properties": {
              "raw": {
                "type": "string",
                "description": "The base64url-encoded RFC 2822 message."
              },
              "threadId": {
                "type": "string",
                "description": "Thread to send this message into, for a reply."
              }
            },
            "required": [
              "raw"
            ]
          }
        },
        "required": [
          "body"
        ]
      },
      "request": {
        "method": "POST",
        "path": "/gmail/v1/users/me/messages/send",
        "body": "{body}"
      }
    },
    {
      "type": "skill",
      "id": "gmail_etiquette",
      "module": "mail",
      "name": "Sending mail well",
      "description": "When to send, when to confirm first, and which failures not to retry.",
      "path": "skill.md"
    }
  ]
}
